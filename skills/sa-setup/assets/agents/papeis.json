{
  "$comment": "Fonte única dos agentes do Sabiá. O scripts/gerar_agentes.py junta isto com o .kiro/config/sabia/agentes.json do projeto e grava .kiro/agents/sa-<papel>.json (Kiro IDE e CLI V3). Regras em references/agentes.md. Padrão com {{X}} cujo valor no projeto é null sai da saída.",
  "mcp_do_power": {
    "elm": ["elm_status", "elm_ler_wi", "elm_listar_wi", "elm_criar_wi", "elm_atualizar_wi", "elm_transicao", "elm_comentar",
            "elm_anexo", "elm_horas", "elm_lancar_horas", "elm_remover_horas", "elm_ligar", "elm_buscar_req", "elm_ler_req",
            "elm_publicar_req", "elm_criar_ct", "elm_iteracao", "elm_backlog", "elm_sync", "elm_buscar_req_local",
            "elm_ler_req_local", "elm_listar_req_local", "elm_indexar_local", "elm_setup_descobrir"],
    "gitlabpr": ["gitlab_listar_mrs", "gitlab_obter_mr", "gitlab_criar_mr", "gitlab_mesclar_mr"]
  },
  "grupos": {
    "elm-local": ["elm/elm_buscar_req_local", "elm/elm_ler_req_local", "elm/elm_listar_req_local", "elm/elm_indexar_local"],
    "elm-leitura": ["elm/elm_status", "elm/elm_ler_wi", "elm/elm_listar_wi", "elm/elm_horas", "+elm-local"],
    "elm-tarefa": ["elm/elm_transicao", "elm/elm_comentar", "elm/elm_anexo", "elm/elm_lancar_horas", "elm/elm_remover_horas"],
    "gitlab-leitura": ["gitlabpr/gitlab_listar_mrs", "gitlabpr/gitlab_obter_mr"]
  },
  "shell": {
    "git-leitura": {
      "comandos": ["git status*", "git diff*", "git log*", "git show*", "git grep*", "git ls-files*", "git ls-tree*",
                   "git rev-parse*", "git branch", "git branch --show-current", "git branch --list*", "git branch -a*",
                   "git branch -r*", "git branch -v*", "git worktree list*", "git for-each-ref*", "git config user.name",
                   "git config user.email"],
      "exceto": ["*--output*", "*--no-index*", "* -O*", "*--open-files-in-pager*", "*--ext-diff*"]
    },
    "worktree": {"comandos": ["cd .kiro/local/wt/*"], "exceto": ["*..*"]},
    "creditos": {"comandos": ["uv run --no-project python *sa-status/scripts/creditos.py*"]},
    "git-escrita": {
      "comandos": ["git add *", "git commit *", "git fetch*", "git pull --ff-only*", "git switch *"],
      "exceto": ["* -f*", "* --ff", "* --ff *"]
    },
    "negar": ["git -C *", "git -c *", "*git merge*", "*git rebase*", "*git pull*--rebase*", "*git pull*--no-ff*",
              "*git commit* -n", "*git commit* -n *", "*--discard-changes*", "*git reset*--hard*", "*git clean*", "*git stash*",
              "*git checkout -- *", "*git checkout .*", "*git restore *", "*git worktree remove*", "*git branch*-D*",
              "*git branch*-M*", "*--force*", "*--delete*", "*--no-verify*", "*--upload-pack*", "*--receive-pack*",
              "*gh pr merge*", "*glab mr merge*", "*rm -rf*", "*rm -fr*", "*.env*", "*.ssh/*", "*.aws/*", "*.config/mcp-*",
              "*.pem*", "*.key", "*.key *", "*{{BUNDLE}}*"],
    "push-perigoso": ["*git push* -f*", "*git push* +*", "*git push* :*", "*git push*--mirror*", "*git push*--all*",
                      "*git push*--prune*", "*git push", "*git push origin", "*git push* HEAD*", "*git push* @*",
                      "*git push*:{{BASE}}*", "*git push*heads/{{BASE}}*"]
  },
  "ler": {
    "permitir": ["./**", "{{POWER}}/**"],
    "negar": ["**/.env", "**/.env/**", "**/.env.*", "**/.env.*/**", "**/*.pem", "**/*.pem/**", "**/*.key", "**/*.key/**",
              "~/.ssh/**", "~/.aws/**", "~/.config/mcp-elm/**", "~/.config/mcp-gitlabpr/**", "{{BUNDLE}}/**"]
  },
  "papeis": {
    "produto": {
      "description": "Sabiá product agent — triages every new demand and records it in the backlog, runs the alignment interview (grill), writes the epic's PRD, breaks it into vertical slices (fatias), handles agile planning (roadmap, sprint, review, sprint rollover (virada)), Sustentação (customer Atendimento and the other categories) and the consolidation of a pronta slice, working with the domain glossary and ELM. Never writes code.",
      "welcomeMessage": "Vamos trabalhar em quê? (nova demanda, PRD, fatiar, planejar a sprint, review, virada, atendimento ou outro item de Sustentação, consolidar uma fatia pronta)",
      "skills": ["sa-triar", "sa-entrevistar", "sa-prd", "sa-fatiar", "sa-planejamento", "sa-atender", "sa-executar", "sa-consolidar",
                 "sa-aprender", "sa-especificar", "sa-iniciar", "sa-status"],
      "subagentes": ["sa-pesquisador", "sa-revisor"],
      "shell": ["git-leitura", "worktree", "creditos", "git-escrita"],
      "push": "negar",
      "escreve": ["{{PRODUTO}}/**", "{{GLOSSARIO}}", "{{ADR}}/**", ".kiro/specs/*/decisoes.md", ".kiro/specs/*/status.md",
                  ".kiro/specs/*/verificacao.md", ".kiro/specs/*/elm/**", ".kiro/local/wt/*/.kiro/specs/*/decisoes.md",
                  ".kiro/local/sustentacao/**", ".kiro/local/especificacao/**"],
      "mcp_libera": ["+elm-leitura", "elm/elm_buscar_req", "elm/elm_ler_req", "+gitlab-leitura"],
      "mcp_pergunta": ["+elm-tarefa", "elm/elm_criar_wi", "elm/elm_atualizar_wi", "elm/elm_ligar", "elm/elm_publicar_req",
                       "elm/elm_criar_ct", "elm/elm_iteracao", "elm/elm_sync"]
    },
    "pesquisador": {
      "description": "Sabiá researcher, read-only on the code — reads the code, the ELM documentation in the repository and the database (queries only) and returns facts with file:line in research.md, without giving opinions or proposing solutions. Use it to research a slice (fatia) before the plan and to look up facts during interviews and PRDs.",
      "welcomeMessage": "Qual fatia (FT-nnn) ou pergunta sobre o código devo pesquisar?",
      "skills": ["sa-pesquisar"],
      "shell": ["git-leitura", "worktree", "creditos"],
      "shell_negar": ["*git add*", "*git commit*", "*git switch*", "*git worktree add*"],
      "push": "negar",
      "escreve": [".kiro/specs/*/research.md", ".kiro/local/wt/*/.kiro/specs/*/research.md"],
      "mcp_libera": ["+elm-local"]
    },
    "codificador": {
      "description": "Sabiá coder — plans the slice (fatia) in Kiro's spec format (sa-plano) and implements it in a test cycle with backpressure (sa-implementar), using the project's toolkit skills bound to it. Takes the slice all the way to merge (push of the slice branch with confirmation, PR, and merge of the approved PR) and records its situação (iniciada, pronta) on the base branch, with confirmation. In autonomous mode it works only in the worktree it was given, and neither pushes nor opens a PR.",
      "welcomeMessage": "Qual fatia (FT-nnn) devo planejar ou implementar?",
      "skills": ["sa-plano", "sa-implementar", "sa-desenvolver", "sa-iniciar", "sa-status"],
      "subagentes": ["sa-pesquisador", "sa-revisor", "sa-verificador"],
      "shell": ["git-leitura", "worktree", "creditos", "git-escrita"],
      "shell_permitir": ["uuidgen*"],
      "shell_perguntar": ["git reset --keep origin/*"],
      "comandos": ["build", "verificacao"],
      "http_sh": true,
      "push": "perguntar",
      "escreve": ["./**"],
      "nao_escreve": ["**/.kiro/agents/**", "**/.kiro/hooks/**", "**/.kiro/workflows/**", "**/.kiro/steering/**", "{{PRODUTO}}/**",
                      ".kiro/local/wt/*/{{PRODUTO}}/**", ".kiro/local/wf/**", "**/.git/**", "**/.git", "**/.kiro/sabia/**",
                      "**/.kiro/settings/**", "**/.kiro/skills/**", "**/.kiro/toolkits/**", "**/.kiro/config/**", "**/AGENTS.md"],
      "nao_escreve_exceto": ["{{PRODUTO}}/backlog.md", "{{PRODUTO}}/sprints/**"],
      "mcp_libera": ["+elm-leitura", "+gitlab-leitura"],
      "mcp_pergunta": ["+elm-tarefa", "elm/elm_criar_wi", "elm/elm_atualizar_wi", "elm/elm_ligar", "gitlabpr/gitlab_criar_mr",
                       "gitlabpr/gitlab_mesclar_mr"]
    },
    "revisor": {
      "description": "Sabiá independent reviewer, with a clean context — reviews a PRD (rubric P), a slice plan (rubric L) or code (rubric C, with the spec and standards axes kept separate), runs the backpressure and writes only its own report. Never changes code, plans or documentation.",
      "welcomeMessage": "O que devo revisar? (PRD de um épico, plano ou código de uma fatia)",
      "skills": ["sa-revisar", "sa-iniciar", "sa-status"],
      "shell": ["git-leitura", "worktree", "creditos", "git-escrita"],
      "shell_negar": ["*git push* {{BASE}}", "*git push* {{BASE}} *"],
      "comandos": ["build"],
      "push": "perguntar",
      "escreve": [".kiro/specs/*/revisao-*.md", ".kiro/local/wt/*/.kiro/specs/*/revisao-*.md", ".kiro/specs/*/analise-*.md",
                  ".kiro/local/wt/*/.kiro/specs/*/analise-*.md", "{{PRODUTO}}/epicos/*/revisao-*.md",
                  ".kiro/local/especificacao/*/revisao-prd-*.md", ".kiro/local/wf/*/*.json", ".kiro/specs/*/status.md",
                  ".kiro/local/wt/*/.kiro/specs/*/status.md"],
      "mcp_libera": ["+elm-leitura", "+gitlab-leitura"],
      "mcp_pergunta": ["+elm-tarefa"]
    },
    "verificador": {
      "description": "Sabiá acceptance verifier — runs end to end, against the real application (API, batch job, browser screen, data load), every scenario in the slice's definition-of-done contract, with test data and evidence per scenario, decides ACEITO/REJEITADO and generates CT.csv for ETM. Never changes production code.",
      "welcomeMessage": "Qual fatia (FT-nnn) devo verificar?",
      "skills": ["sa-verificar", "sa-iniciar", "sa-status"],
      "shell": ["git-leitura", "worktree", "creditos", "git-escrita"],
      "shell_perguntar": ["curl *", "wget *"],
      "shell_negar": ["*git push* {{BASE}}", "*git push* {{BASE}} *"],
      "comandos": ["verificacao"],
      "http_sh": true,
      "push": "perguntar",
      "escreve": [".kiro/specs/*/verificacao.md", ".kiro/local/wt/*/.kiro/specs/*/verificacao.md", ".kiro/specs/*/CT.csv",
                  ".kiro/local/wt/*/.kiro/specs/*/CT.csv", ".kiro/specs/*/status.md", ".kiro/local/wt/*/.kiro/specs/*/status.md",
                  ".kiro/specs/*/evidencias/**", ".kiro/local/wt/*/.kiro/specs/*/evidencias/**", ".kiro/specs/*/massa/**",
                  ".kiro/local/wt/*/.kiro/specs/*/massa/**", ".kiro/local/verificacao/**", ".kiro/local/wf/*/aceite.json",
                  "{{MASSA}}/**"],
      "mcp_libera": ["+elm-leitura"],
      "mcp_pergunta": ["+elm-tarefa"]
    },
    "orquestrador": {
      "description": "Sabiá orchestrator — runs the sa-loop skill, taking planned AFK slices (fatias) from research to an open PR, one worktree per slice in .kiro/local/wt/, delegating each phase to a clean-context subagent (pesquisador, codificador, revisor, verificador), within the human-review WIP limit. The only one that creates worktrees; records the batch as iniciada on the base branch and pushes with the authorization given at the start of the batch. Never merges.",
      "welcomeMessage": "Quais fatias AFK devo levar até o PR? (lista de FT-nnn ou \"as planejadas da sprint\")",
      "skills": ["sa-loop", "sa-status", "sa-desenvolver", "sa-plano", "sa-implementar"],
      "subagentes": ["sa-pesquisador", "sa-codificador", "sa-revisor", "sa-verificador"],
      "shell": ["git-leitura", "worktree", "creditos", "git-escrita"],
      "shell_permitir": ["uuidgen*", "git worktree add .kiro/local/wt/*"],
      "shell_perguntar": ["git reset --keep origin/*"],
      "shell_negar": ["*git worktree add*..*"],
      "comandos": ["build", "verificacao"],
      "http_sh": true,
      "push": "loop",
      "escreve": [".kiro/local/loop-*.md", ".kiro/specs/**", ".kiro/local/wt/*/**", "{{PRODUTO}}/backlog.md",
                  "{{PRODUTO}}/sprints/**"],
      "nao_escreve": [".kiro/local/wt/*/.kiro/agents/**", ".kiro/local/wt/*/.kiro/hooks/**", ".kiro/local/wt/*/.kiro/workflows/**",
                      ".kiro/local/wt/*/.kiro/steering/**", ".kiro/local/wt/*/.kiro/sabia/**", ".kiro/local/wt/*/{{PRODUTO}}/**",
                      "**/.git/**", "**/.git"],
      "mcp_libera": ["+elm-leitura", "+gitlab-leitura"],
      "mcp_pergunta": ["+elm-tarefa", "elm/elm_criar_wi", "elm/elm_atualizar_wi", "elm/elm_ligar", "gitlabpr/gitlab_criar_mr"]
    }
  }
}
